# Hosmos — Monorepo Environment Reference
#
# This file documents ALL environment variables used across the monorepo.
# Each workspace has its own .env.example with workspace-specific variables.
#
# Backend:  backend/.env.example
# Frontend: frontend/.env.example

# ─── Backend ──────────────────────────────────
# NODE_ENV=development
# PORT=3001
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hosmos_dev
# JWT_SECRET=<64+ char random string>
# JWT_ACCESS_EXPIRY_SECONDS=900
# JWT_REFRESH_EXPIRY_SECONDS=2592000
# BCRYPT_COST_FACTOR=12
# AADHAAR_ENCRYPTION_KEY=<64 hex chars>
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# COOKIE_DOMAIN=localhost

# ─── Frontend ─────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
