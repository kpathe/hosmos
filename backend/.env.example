# ─────────────────────────────────────────────
# Hosmos Backend — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ─── Server ───────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/hosmos_dev

# ─── JWT ──────────────────────────────────────
# Must be at least 256 bits of entropy (64 hex chars)
JWT_SECRET=change_this_to_a_secure_random_256bit_hex_string_in_production
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=2592000

# ─── Bcrypt ───────────────────────────────────
BCRYPT_COST_FACTOR=12

# ─── Aadhaar Encryption ───────────────────────
# AES-256-GCM key: must be exactly 64 hex chars (32 bytes)
AADHAAR_ENCRYPTION_KEY=change_this_to_a_secure_random_64char_hex_string

# ─── CORS ─────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Cookie ───────────────────────────────────
# In production: set to your actual domain (e.g., .hosmos.app)
COOKIE_DOMAIN=localhost
